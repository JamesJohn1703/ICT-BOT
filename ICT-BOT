datetime GetFirstDailyHighBreakTime()
{
    static datetime firstBreakTime = 0;
    static double dailyHigh = 0;
    static bool highBroken = false;
    static int currentDay = -1;

    datetime now = TimeCurrent();
    MqlDateTime timeStruct;
    TimeToStruct(now, timeStruct);

    // New day reset
    if (timeStruct.day != currentDay)
    {
        currentDay = timeStruct.day;
        highBroken = false;
        firstBreakTime = 0;
        dailyHigh = iHigh(_Symbol, PERIOD_D1, 0);  // Today's high so far
    }

    double price = SymbolInfoDouble(_Symbol, SYMBOL_BID);

    if (!highBroken && price > dailyHigh)
    {
        highBroken = true;
        firstBreakTime = now;
    }

    return firstBreakTime;  // Will be 0 if not broken yet
}


datetime GetFirstDailyLowBreakTime()
{
    static datetime firstBreakTime = 0;
    static double dailyLow = 0;
    static bool lowBroken = false;
    static int currentDay = -1;

    datetime now = TimeCurrent();
    MqlDateTime timeStruct;
    TimeToStruct(now, timeStruct);

    // New day reset
    if (timeStruct.day != currentDay)
    {
        currentDay = timeStruct.day;
        lowBroken = false;
        firstBreakTime = 0;
        dailyLow = iLow(_Symbol, PERIOD_D1, 0);  // Today's high so far
    }

    double price = SymbolInfoDouble(_Symbol, SYMBOL_BID);

    if (!lowBroken && price > dailyLow)
    {
        lowBroken = true;
        firstBreakTime = now;
    }

    return firstBreakTime;  // Will be 0 if not broken yet
}

//+------------------------------------------------------------------+
//|  Finds the first bearish FVG after a given time                  |
//|  Returns the index of the middle candle (C2) or -1 if not found  |
//+------------------------------------------------------------------+
void FindBearishFVG(int lookback = 500)
{
   int startIndex = iBarShift(_Symbol, PERIOD_M15, HighbreakTime, false);
   if(startIndex < 0) return;   // nothing to do if no bar matches

   // Loop from older to newer candles after startIndex
   for(int i = startIndex - 2; i >= 0 && i >= startIndex - lookback; i--)
   {
      // Safety: make sure we don’t access negative indexes
      if(i + 2 >= iBars(_Symbol, PERIOD_M15)) continue;

      double highC3 = iHigh(_Symbol, PERIOD_M15, i);       // Candle 3 (newer)
      double lowC1  = iLow(_Symbol, PERIOD_M15, i + 2);    // Candle 1 (older)
      double closeC2= iClose(_Symbol, PERIOD_M15, i + 1);  // Candle 2 (middle)
      double openC2 = iOpen(_Symbol, PERIOD_M15, i + 1);
      double stoploss   = iHigh(_Symbol, PERIOD_M15, i + 2);  // Oldest
      double takeprofit = iLow(_Symbol, PERIOD_M15, i);       // Newest

      // Bearish FVG condition
      if(highC3 < lowC1 && closeC2 < openC2 &&
         RecentLowBreakTime != 0 && RecentLowBreakTime > GetFirstDailyHighBreakTime())
      {
         // Place your trade
         buyLimit(highC3, stoploss, takeprofit);
      }
   }
}

//+------------------------------------------------------------------+
//|  Finds the first bullish FVG after a given time                  |
//|  Returns the index of the middle candle (C2) or -1 if not found  |
//+------------------------------------------------------------------+
void FindBullishFVG(int lookback = 500)
{
   int startIndex = iBarShift(_Symbol, PERIOD_M15, LowbreakTime, false);
   if(startIndex < 0) return;

   // loop from older to newer candles after LowbreakTime
   for(int i = startIndex - 2; i >= 0 && i >= startIndex - lookback; i--)
   {
      double lowC3    = iLow(_Symbol, PERIOD_M15, i);       // Newest candle low
      double highC1   = iHigh(_Symbol, PERIOD_M15, i + 2);  // Oldest candle high
      double closeC2  = iClose(_Symbol, PERIOD_M15, i + 1); // Middle candle close
      double openC2   = iOpen(_Symbol, PERIOD_M15, i + 1);  // Middle candle open
      double stoploss = iLow(_Symbol, PERIOD_M15, i + 2);   // Oldest candle low
      double takeprofit = iHigh(_Symbol, PERIOD_M15, i);    // Newest candle high

      // Bullish FVG condition: gap + bullish middle candle
      if(lowC3 > highC1 && closeC2 > openC2 && RecentHighBreakTime != 0 && RecentHighBreakTime > getRecentLowBreakTime())
      {
         buyLimit(lowC3, stoploss, takeprofit); // corrected to buy
      }
   }
}


//Gets the recent low before the clear of daily high
double GetSpecificDayLocalLow()
   {
      datetime day_start = iTime(_Symbol, PERIOD_D1, 0);          // start of current day
      datetime day_end   = day_start + 86400;                     // start of next day
      
      int total_bars = iBars(_Symbol, PERIOD_M15);
   
      for(int i = 1; i < total_bars - 1; i++)
      {
         datetime t = iTime(_Symbol, PERIOD_M15, i);
         
         // Only check if candle is inside current day
         if(t >= day_start && t < day_end)
         {
            double low_prev = iLow(_Symbol, PERIOD_M15, i+1);
            double low_curr = iLow(_Symbol, PERIOD_M15, i);
            double low_next = iLow(_Symbol, PERIOD_M15, i-1);
   
            // local minimum condition
            if(low_curr < low_prev && low_curr < low_next)
            {
               // match the specific time exactly
               if(t < HighbreakTime)
                  return low_curr;
            }
         }
      }
      
      return 0; // not found
   }

//Gets the recent high before the clear of daily high
double GetSpecificDayLocalHigh()
   {
      datetime day_start = iTime(_Symbol, PERIOD_D1, 0);          // start of current day
      datetime day_end   = day_start + 86400;                     // start of next day
      
      int total_bars = iBars(_Symbol, PERIOD_M15);
   
      for(int i = 1; i < total_bars - 1; i++)
      {
         datetime t = iTime(_Symbol, PERIOD_M15, i);
         
         // Only check if candle is inside current day
         if(t >= day_start && t < day_end)
         {
            double high_prev = iHigh(_Symbol, PERIOD_M15, i+1);
            double high_curr = iHigh(_Symbol, PERIOD_M15, i);
            double high_next = iHigh(_Symbol, PERIOD_M15, i-1);
   
            // local minimum condition
            if(high_curr > high_prev && high_curr > high_next)
            {
               // match the specific time exactly
               if(t < LowbreakTime)
                  return high_curr;
            }
         }
      }
      
      return 0; // not found
   }
   
//This places a buy limit trade
void buyLimit (double entry, double stoploss, double takeprofit)
   {
      if (HighbreakTime != 0 && recentHigh != 0 && getRecentHighBreakTime() != 0){
      if(tradeCount<2)
         {
            Trade.BuyLimit(lotsize,entry,NULL,stoploss,takeprofit,ORDER_TIME_DAY);
         }}
   }
   
//This places a sell limit trade
void sellLimit (double entry, double stoploss, double takeprofit)
   {
      if (LowbreakTime != 0 && recentLow != 0 && getRecentLowBreakTime() != 0){
      if(tradeCount<2)
         {
            Trade.SellLimit(lotsize,entry,NULL,stoploss,takeprofit,ORDER_TIME_DAY);
         }}
   }
   
   
//The first time the recent high before daily low break is broken  
datetime getRecentHighBreakTime()
{
   int bars = iBars(_Symbol, PERIOD_M15);
   if(bars < 2) return 0;   // not enough bars

   // Loop from oldest (bars-1) to newest (0)
   for(int i = bars - 1; i >= 1; i--) 
   {
      double high = iHigh(_Symbol, PERIOD_M15, i);
      datetime barTime = iTime(_Symbol, PERIOD_M15, i);

      // Check if bar crosses the level
      if(high >= recentHigh)
      {
         return barTime;   // first time level was broken
      }
   }

   return 0;  // not broken yet
}

//The first time the recent low before daily low break is broken  
datetime getRecentLowBreakTime()
{
   int bars = iBars(_Symbol, PERIOD_M15);
   if(bars < 2) return 0;   // not enough bars

   // Loop from oldest (bars-1) to newest (0)
   for(int i = bars - 1; i >= 1; i--) 
   {
      double low  = iLow(_Symbol, PERIOD_M15, i);
      datetime barTime = iTime(_Symbol, PERIOD_M15, i);

      // Check if bar crosses the level
      if(low <= recentLow)
      {
         return barTime;   // first time level was broken
      }
   }

   return 0;  // not broken yet
}



