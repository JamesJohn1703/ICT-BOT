      MqlDateTime t;
      TimeToStruct(todayStart, t);

      if(t.day != lastDay) // new day
      {
         lastDay = t.day;
         Print("New Day Detected. Reloading EA daily values...");
      }
      GetDailyValues();
  }
  
void GetDailyValues()
{
   // Put all your "once-a-day" calculations here
   datetime HighbreakTime = GetFirstDailyHighBreakTime();
   datetime LowbreakTime = GetFirstDailyLowBreakTime();
   
   double recentLow = GetSpecificDayLocalLow();
   double recentHigh = GetSpecificDayLocalHigh();
   
   if(dailybias == 0)
     {
        FindBearishFVG();
        FindBullishFVG();
     }
   else if(dailybias == 1 && iHigh(_Symbol,PERIOD_D1,1) > iHigh(_Symbol,PERIOD_D1,2))
          {
            FindBullishFVG();
          }
   else if(dailybias == 2 && iLow(_Symbol,PERIOD_D1,1) < iLow(_Symbol,PERIOD_D1,2))
          {
            FindBearishFVG();
          }
   
}

