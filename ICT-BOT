void high()
   {
      for (int i = 2; i < 96; i++) // Start from i=2 to ensure we have previous and next bars
         {
             datetime barTime = iTime(NULL, PERIOD_M15, i);
             
             // Check if the bar is within the current day range
             if (barTime >= currentDayStart && barTime < currentDayEnd)
                {
                    double highPrev = NormalizeDouble(iHigh(NULL, PERIOD_M15, i - 1), _Digits); // High of the previous candle
                    double highMid = NormalizeDouble(iHigh(NULL, PERIOD_M15, i), _Digits);      // High of the middle (current) candle
                    double highNext = NormalizeDouble(iHigh(NULL, PERIOD_M15, i + 1), _Digits); // High of the next candle
            
                    // Check if the high of the middle candle is greater than the previous and next candles
                    if (highPrev < highMid && highMid > highNext)
                       {
                           Print("The high before the clear of liquidity is: ", highMid);
                       }
                }
         }
   }
void low()
   {
      for (int i = 2; i < 96; i++) // Start from i=2 to ensure we have previous and next bars
         {
             datetime barTime = iTime(NULL, PERIOD_M15, i);
             
             // Check if the bar is within the current day range
             if (barTime >= currentDayStart && barTime < currentDayEnd)
                {
                    double lowPrev = NormalizeDouble(iLow(NULL, PERIOD_M15, i - 1), _Digits); // Low of the previous candle
                    double lowMid = NormalizeDouble(iLow(NULL, PERIOD_M15, i), _Digits);      // Low of the middle (current) candle
                    double lowNext = NormalizeDouble(iLow(NULL, PERIOD_M15, i + 1), _Digits); // Low of the next candle
            
                    // Check if the low of the middle candle is lower than the previous and next candles
                    if (lowPrev > lowMid && lowMid < lowNext)
                       {
                           Print("The low before the clear of liquidity is: ", lowMid);
                       }
                }
         }
    }
void object()
   {
      // Create an object to draw the lines at the highs and lows
int lineCounter = 0; // Counter to create unique object names

// Loop through the bars of the current day in 15-minute intervals
for (int i = 2; i < 96; i++) // Start from i=2 to ensure we have previous and next bars
{
    datetime barTime = iTime(NULL, PERIOD_M15, i);
    
    // Check if the bar is within the current day range
    if (barTime >= currentDayStart && barTime < currentDayEnd)
    {
        double highPrev = NormalizeDouble(iHigh(NULL, PERIOD_M15, i - 1), _Digits); // High of the previous candle
        double highMid = NormalizeDouble(iHigh(NULL, PERIOD_M15, i), _Digits);      // High of the middle (current) candle
        double highNext = NormalizeDouble(iHigh(NULL, PERIOD_M15, i + 1), _Digits); // High of the next candle

        // Check if the high of the middle candle is greater than the previous and next candles
        if (highPrev < highMid && highMid > highNext)
        {
            // Draw a line at the high of the middle candle
            string highLineName = "HighLine_" + IntegerToString(lineCounter);
            ObjectCreate(0, highLineName, OBJ_TREND, 0, barTime, highMid, iTime(NULL, PERIOD_M15, i + 1), highMid);
            ObjectSetInteger(0, highLineName, OBJPROP_COLOR, clrWhite); // Set the color to white
            lineCounter++;
        }

        double lowPrev = NormalizeDouble(iLow(NULL, PERIOD_M15, i - 1), _Digits); // Low of the previous candle
        double lowMid = NormalizeDouble(iLow(NULL, PERIOD_M15, i), _Digits);      // Low of the middle (current) candle
        double lowNext = NormalizeDouble(iLow(NULL, PERIOD_M15, i + 1), _Digits); // Low of the next candle

        // Check if the low of the middle candle is lower than the previous and next candles
        if (lowPrev > lowMid && lowMid < lowNext)
        {
            // Draw a line at the low of the middle candle
            string lowLineName = "LowLine_" + IntegerToString(lineCounter);
            ObjectCreate(0, lowLineName, OBJ_TREND, 0, barTime, lowMid, iTime(NULL, PERIOD_M15, i + 1), lowMid);
            ObjectSetInteger(0, lowLineName, OBJPROP_COLOR, clrWhite); // Set the color to white
            lineCounter++;
        }
    }
}

   }
   
void Daily_high_and_low_break()
   {
   //Low
   double prevDayLow = NormalizeDouble(iLow(NULL,PERIOD_D1,0),_Digits);
   double currentPriceLow = NormalizeDouble(SymbolInfoDouble(_Symbol,SYMBOL_BID),_Digits);

   if (prevDayLow < currentPriceLow)
      {
      Print("The daily high has been cleared at: ",prevDayLow);
      }
      
   //High
   double prevDayHigh = NormalizeDouble(iHigh(NULL,PERIOD_D1,0),_Digits);
   double currentPriceHigh = NormalizeDouble(SymbolInfoDouble(_Symbol,SYMBOL_ASK),_Digits);
   if (prevDayHigh < currentPriceHigh)
      {
      Print("The daily high has been cleared at: ",prevDayHigh);
      }
   
   }

void FVG()
   {
   for (int i=2; i<96; i++)
      {
      datetime barTime = iTime(_Symbol,PERIOD_M15,i);
      
      if(barTime >= currentDayStart && barTime < currentDayEnd)
         {
         //bullish
         double prevDayLow = NormalizeDouble(iLow(NULL,PERIOD_D1,0),_Digits);
         double currentPriceLow = NormalizeDouble(SymbolInfoDouble(_Symbol,SYMBOL_BID),_Digits);
      
         if (prevDayLow < currentPriceLow)
            {
             //Print("The daily high has been cleared at: ",prevDayLow);
            }
         double barOneLow = NormalizeDouble(iLow(_Symbol,PERIOD_M15,i-1),_Digits);
         double barTwoHigh = NormalizeDouble(iHigh(_Symbol,PERIOD_M15,i+1),_Digits);
         
         if( barOneLow > barTwoHigh  && prevDayLow > currentPriceLow)
            {
            Print("There is a bulish FVG at: ",barOneLow);
            }
          //bearish
          double prevDayHigh = NormalizeDouble(iHigh(NULL,PERIOD_D1,0),_Digits);
          double currentPriceHigh = NormalizeDouble(SymbolInfoDouble(_Symbol,SYMBOL_ASK),_Digits);
          if (prevDayHigh < currentPriceHigh)
            {
             //Print("The daily high has been cleared at: ",prevDayHigh);
            }
      
          double barOneHigh = NormalizeDouble(iHigh(_Symbol,PERIOD_M15,i-1),_Digits);
          double barTwoLow = NormalizeDouble(iLow(_Symbol,PERIOD_M15,i+1),_Digits);
          
          if(barOneHigh < barTwoLow && prevDayHigh < currentPriceHigh)
            {
            Print("There is a bearish FVG at: ",barOneHigh);
            }
          }
      }
   }
   
